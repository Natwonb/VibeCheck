{
  "name": "DailyResponse",
  "type": "object",
  "properties": {
    "challenge_date": {
      "type": "string"
    },
    "challenge_text": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "votes": {
      "type": "number",
      "default": 0
    },
    "voter_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "report_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "challenge_date",
    "answer"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}