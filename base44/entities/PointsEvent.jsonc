{
  "name": "PointsEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "action_key": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "meta": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "action",
    "action_key",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}